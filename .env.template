
POSTGRES_USER=postgres
POSTGRES_PASSWORD=blank
POSTGRES_DB=bloembraaden

# put this in your hosts file to point to 127.0.0.1 for all subdomains of it: *.bloembraaden.local 127.0.0.1
# static assets for all instances will be served from 'static.bloembraaden.local'
MAIN_URL=bloembraaden.local
# installing main admin access for one mandatory url
BLOEMBRAADEN_ADMIN_EMAIL=
BLOEMBRAADEN_ADMIN_PASSWORD=
BLOEMBRAADEN_VERSION=
# true will attempt to install every time, when you have a working setup, set it to false in your .env file
BLOEMBRAADEN_INSTALL=true

## miscellaneous
FRAME_ANCESTORS="list of urls that may embed your content, or empty"

# integrations
MAILCHIMP_API_KEY=
PDFMAKER_API_KEY=

# for pg_isready and install-bloembraaden psql
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
