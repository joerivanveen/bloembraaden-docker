{
  "DB_MAIN": {
    "host": "postgres",
    "port": "5432",
    "name": "$POSTGRES_DB",
    "user": "$POSTGRES_USER",
    "pass": "$POSTGRES_PASSWORD",
    "schema": "public"
  },
  "MAIL": {
    "active": "mailchimp",
    "mailchimp": {
      "api_key": "$MAILCHIMP_API_KEY"
    },
    "sendgrid": {
      "api_key": "$SENDGRID_API_KEY"
    },
    "mailgun": {
      "api_key": "$MAILGUN_API_KEY"
    }
  },
  "integrations": {
    "pdfmaker": {
      "api_key": "$PDFMAKER_API_KEY",
      "api_url": "https://production-ams.browserless.io/pdf"
    }
  },
  "search_cache_refresh_minutes": 30,
  "search_cache_max_minutes": 600,
  "newrelic_records_backend": false,
  "max_memory_limit": "1g",
  "frame_ancestors": "$FRAME_ANCESTORS",
  "VERBOSE": true,
  "HASHKEY": "$HASHKEY",
  "dbcache": "/tmp/cache/",
  "cdnpath": "/mnt/static/htdocs/",
  "cdnroot": "https://static.$MAIN_URL/",
  "logfile": "/tmp/logs/bloembraaden_",
  "uploads": "/mnt/uploads/",
  "invoice": "/mnt/invoice/",
  "version": "$BLOEMBRAADEN_VERSION",
  "install": $BLOEMBRAADEN_INSTALL
}
